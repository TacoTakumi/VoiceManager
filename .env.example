# VoiceManager configuration — copy to .env and fill in values
# Clients authenticate with bearer tokens kept in the user store. Create them with:
#   voicemanager user add NAME
#   voicemanager user token add NAME TOKEN_NAME

# User store (SQLite). Unset: $XDG_STATE_HOME/voicemanager/state.db,
# else ~/.local/state/voicemanager/state.db. The CLI and the server must use the same path.
# VM_DB_PATH=/home/you/.local/state/voicemanager/state.db

# Optional (defaults shown):
VM_HOST=0.0.0.0
VM_PORT=8255
VM_WHISPER_MODEL=tiny
VM_DEVICE=auto                # auto picks GPU with most free VRAM; or: cpu, cuda, cuda:0, cuda:1
VM_VAD_THRESHOLD=0.5
VM_VAD_SILENCE_MS=500

# STT engine selection: audiocpp (default), whisper, qwen, or nemotron
# VM_STT_ENGINE=audiocpp

# Qwen3-ASR settings (only used when VM_STT_ENGINE=qwen)
# VM_QWEN_MODEL=Qwen/Qwen3-ASR-0.6B
# VM_QWEN_GPU_MEMORY_UTILIZATION=0.5
# VM_QWEN_MAX_NEW_TOKENS=256
# VM_QWEN_MAX_MODEL_LEN=4096
# VM_QWEN_SILENCE_MS=2000

# Nemotron cache-aware streaming STT (only used when VM_STT_ENGINE=nemotron)
# VM_NEMOTRON_MODEL=nvidia/nemotron-speech-streaming-en-0.6b
# Cache-aware latency mode: att_context_size = [left, right] in 80ms frames (right in {0,1,6,13}).
# VM_NEMOTRON_ATT_CONTEXT_LEFT=70
# VM_NEMOTRON_ATT_CONTEXT_RIGHT=13
# End-of-utterance endpointing thresholds.
# VM_NEMOTRON_EOU_STOP_HISTORY_MS=800
# VM_NEMOTRON_EOU_RESIDUE_TOKENS=2

# audio.cpp streaming STT sidecar (only used when VM_STT_ENGINE=audiocpp).
# The STT runtime runs in a separate process (crash isolation) reached over a Unix socket.
# Build the sidecar first (see sidecar/README.md); VM_AUDIOCPP_MODEL is the GGUF path.
# Each /ws/stream session spawns its OWN sidecar on a private socket path: a sidecar
# serves one session at a time, and a fatal audio.cpp fault kills every session on its
# process, so one-per-session is what keeps concurrent sessions independent.
# VM_AUDIOCPP_SIDECAR_BIN=sidecar/build/bin/audiocpp_sidecar
# Leave blank (the default) for that. Setting a path instead dials an externally-started
# sidecar and never spawns - handy for measurement, but it is single-session, so a second
# concurrent /ws/stream session gets ERROR busy.
# VM_AUDIOCPP_SOCKET=
# GGUF path. The default is where `python setup_models.py` downloads it.
# VM_AUDIOCPP_MODEL=models/audiocpp/Nemotron-3.5-ASR-Streaming-0.6B-GGUF/nemotron-3.5-asr-streaming-0.6b-f16.gguf
# Which registered model+task the sidecar serves; VM_AUDIOCPP_MODEL must point at the
# matching GGUF. Registered ids: nemotron-3.5-asr-streaming (default),
# voxtral-mini-4b-realtime-asr-streaming (voxtral-mini-4b-realtime-2602-q4_k.gguf).
# VM_AUDIOCPP_MODEL_TASK=nemotron-3.5-asr-streaming
# VM_AUDIOCPP_BACKEND=cuda        # cpu|cuda|vulkan|metal|auto
# VM_AUDIOCPP_DEVICE=0
# VM_AUDIOCPP_THREADS=4
# Idle-feed gate: inter-utterance silence (as classified by the acoustic endpointer)
# is not fed to the decoder; a rolling pre-roll is replayed at speech onset so the
# start of an utterance is not clipped. VM_AUDIOCPP_IDLE_GATE=0 disables the gate
# (feed everything). Do NOT set the pre-roll to 0 with the gate on: frames arriving
# before the VAD confirms speech would be dropped and utterance onsets clipped.
# VM_AUDIOCPP_IDLE_GATE=1
# VM_AUDIOCPP_ONSET_PREROLL_MS=200
# VM_AUDIOCPP_ASSETS_ROOT=        # chdir for the vendored model_specs/; blank = sidecar default
# Comma-separated KEY=VALUE lists forwarded to the sidecar as repeatable
# --session-option / --request-option flags; they override the model_task's registry
# defaults (e.g. voxtral_realtime.stream_batch_tokens=2). Blank = registry defaults.
# VM_AUDIOCPP_SESSION_OPTIONS=
# VM_AUDIOCPP_REQUEST_OPTIONS=
# Concurrency ceiling. One sidecar per session is not free: each concurrent session costs
# one process, one CUDA context and one resident f16 model, all on VM_AUDIOCPP_DEVICE.
# Measured ~1.5 GiB VRAM per session (Nemotron-3.5 f16, RTX 4060 Ti), on top of the
# ~2.8 GiB the server itself holds - so about 8 sessions fit on a 16 GiB card. Sessions
# over this cap are refused up front with a retriable at_capacity error (WS close 4002)
# rather than being allowed to exhaust the GPU. 0 = unbounded.
# VM_AUDIOCPP_MAX_SIDECARS=4

# TTS engine selection: audiocpp (default), openvoice, or vibevoice
# VM_TTS_ENGINE=audiocpp

# VibeVoice settings (only used when VM_TTS_ENGINE=vibevoice)
# VM_VIBEVOICE_MODEL=microsoft/VibeVoice-Realtime-0.5B
# VM_VIBEVOICE_VOICE=Carter
# VM_VIBEVOICE_CFG_SCALE=1.5
# VM_VIBEVOICE_VOICES_DIR=voices/streaming_model

# audio.cpp dots_tts TTS sidecar (only used when VM_TTS_ENGINE=audiocpp).
# The SAME sidecar binary as the STT engine serves TTS (it selects the task at
# HELLO), and it shares VM_AUDIOCPP_SIDECAR_BIN / _BACKEND / _DEVICE / _THREADS
# above. One TTS sidecar process per WS session, ~4.0 GiB VRAM each (dots q8_0,
# RTX 4060 Ti); output is 48 kHz mono s16 PCM.
# VM_AUDIOCPP_TTS_MODEL is the TTS GGUF path. The default is where
# `python setup_models.py` downloads it.
# VM_AUDIOCPP_TTS_MODEL=models/audiocpp/Breeze-TTS-2-GGUF/breeze-tts-2-q8_0.gguf
# VM_AUDIOCPP_TTS_MODEL_TASK=breeze-tts-streaming
#   breeze-tts-streaming is the default. dots-tts-streaming selects dots.tts;
#   pair it with VM_AUDIOCPP_TTS_MODEL=/path/to/dots-tts-soar-q8_0.gguf.
#   voxcpm2-tts-streaming selects VoxCPM2;
#   pair it with VM_AUDIOCPP_TTS_MODEL=/path/to/voxcpm2-q8_0.gguf. Under
#   voxcpm2 a preset's ref_text may be omitted (still required under dots).
#   breeze-tts-streaming selects Breeze-TTS 2 (audio.cpp v0.7.3 pin or later, served by
#   the sidecar build on the current pin); pair it with
#   VM_AUDIOCPP_TTS_MODEL=/path/to/breeze-tts-2-q8_0.gguf. ref_text is
#   required under breeze, and its output is 24 kHz (audio_start follows READY).
#   qwen3-tts-streaming selects Qwen3-TTS 1.7B Base (served by the sidecar build on the
#   current pin); pair it with
#   VM_AUDIOCPP_TTS_MODEL=/path/to/qwen3-tts-12hz-1.7b-base-q8_0_v2.gguf. ref_text is
#   required under qwen3, and its output is 24 kHz (audio_start follows READY).
# Frozen preset voices: refs.json pairs each reference WAV with its exact
# transcript (ref_text); validated fail-fast at startup. Voice names come from
# that manifest. lcars_demo is copyrighted Star Trek audio, for personal,
# non-commercial use only (see the README).
# VM_AUDIOCPP_TTS_VOICES=voices/designed/refs.json
# VM_AUDIOCPP_TTS_VOICE=designed_female_s101
# Seam-silence trim: the sidecar caps a silence run that crosses a dots chunk
# boundary at this many ms (seams measure 400-900 ms untrimmed; natural in-chunk
# pauses 340-620 ms are never touched). 0 disables the trim.
# VM_AUDIOCPP_TTS_SEAM_SILENCE_MS=400
# Comma-separated KEY=VALUE request-option overrides for the TTS sidecar, merged
# over its pinned defaults (text_chunk_size=200, max_tokens=500,
# text_chunk_mode=default) - e.g. text_chunk_size=320 to trade more drift risk
# for fewer seams. Blank = the pins stand. The default seed=2 keeps Breeze output
# the same from run to run.
# VM_AUDIOCPP_TTS_REQUEST_OPTIONS=seed=2
# tts_stream coalescing window. Once the first batch is away, keep collecting
# sentences for this many ms before synthesizing, so a token-by-token producer
# does not turn every sentence into its own clone request - Breeze re-conditions
# the speaker per request, so that walks the voice between sentences. Spent
# against the previous batch's playback (RTF ~0.6 leaves ~40% slack), so it does
# not gap the audio. The first sentence is never delayed. 0 restores the old
# dispatch-whatever-is-queued behavior.
# VM_AUDIOCPP_TTS_COALESCE_MS=350
# Clause mode for tts_stream chunking ("clause"): text is cut at clause marks,
# word counts and playback-aware deadlines instead of whole sentences.
# First piece: sent after this many words, or this many ms, whichever is first.
# VM_TTS_CLAUSE_FIRST_WORDS=4
# VM_TTS_CLAUSE_FIRST_DEADLINE_MS=600
# Later pieces: word count to wait for, and how many ms of unplayed audio to keep.
# VM_TTS_CLAUSE_LATER_WORDS=12
# VM_TTS_CLAUSE_MARGIN_MS=1000
# A clause mark cuts only when the piece up to it holds at least this many words.
# VM_TTS_CLAUSE_MARK_MIN_WORDS=3
